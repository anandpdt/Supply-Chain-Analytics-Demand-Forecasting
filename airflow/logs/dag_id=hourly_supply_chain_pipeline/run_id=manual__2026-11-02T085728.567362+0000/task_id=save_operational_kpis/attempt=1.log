{"timestamp":"2026-11-02T08:57:32.843048Z","level":"info","event":"Running statement: \n            INSERT INTO ops.hourly_operational_kpi_snapshots (\n                simulated_hour,\n                total_demand,\n                fulfilled_units,\n                unmet_units,\n                closing_stock,\n                stockout_rate_percent,\n                fulfillment_rate_percent,\n                projected_days_of_inventory,\n                captured_at\n            )\n\n            SELECT\n                snapshot_hour,\n                total_demand,\n                fulfilled_units,\n                unmet_units,\n                closing_stock,\n                stockout_rate_percent,\n                fulfillment_rate_percent,\n                projected_days_of_inventory,\n                NOW()\n\n            FROM ops.v_live_hourly_kpis\n\n            ORDER BY snapshot_hour DESC\n            LIMIT 1\n\n            ON CONFLICT (simulated_hour)\n            DO UPDATE SET\n                total_demand = EXCLUDED.total_demand,\n                fulfilled_units = EXCLUDED.fulfilled_units,\n                unmet_units = EXCLUDED.unmet_units,\n                closing_stock = EXCLUDED.closing_stock,\n                stockout_rate_percent =\n                    EXCLUDED.stockout_rate_percent,\n                fulfillment_rate_percent =\n                    EXCLUDED.fulfillment_rate_percent,\n                projected_days_of_inventory =\n                    EXCLUDED.projected_days_of_inventory,\n                captured_at = NOW();\n        , parameters: None","dag_id":"hourly_supply_chain_pipeline","task_id":"save_operational_kpis","run_id":"manual__2026-11-02T08:57:28.567362+00:00","ti_id":"01a19b7a-5720-702e-b1a0-2d65f1a49506","try_number":1,"map_index":-1,"logger":"airflow.task.hooks.airflow.providers.postgres.hooks.postgres.PostgresHook","filename":"sql.py","lineno":896}
