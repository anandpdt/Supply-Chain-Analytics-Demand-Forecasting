{"timestamp":"2026-11-02T18:30:05.837190Z","level":"info","event":"Running statement: \n            INSERT INTO analytics.hourly_anomaly_snapshots (\n                snapshot_hour,\n                historical_demand_spikes,\n                simulated_supplier_delays,\n                supplier_warnings,\n                supplier_critical,\n                checked_at\n            )\n\n            SELECT\n                date_trunc('hour', NOW()),\n\n                COUNT(*) FILTER (\n                    WHERE anomaly_type = 'DEMAND_SPIKE'\n                ),\n\n                COUNT(*) FILTER (\n                    WHERE anomaly_type = 'SUPPLIER_DELAY'\n                ),\n\n                COUNT(*) FILTER (\n                    WHERE anomaly_type = 'SUPPLIER_DELAY'\n                      AND severity = 'WARNING'\n                ),\n\n                COUNT(*) FILTER (\n                    WHERE anomaly_type = 'SUPPLIER_DELAY'\n                      AND severity = 'CRITICAL'\n                ),\n\n                NOW()\n\n            FROM analytics.v_control_tower_anomalies\n\n            ON CONFLICT (snapshot_hour)\n            DO UPDATE SET\n                historical_demand_spikes =\n                    EXCLUDED.historical_demand_spikes,\n                simulated_supplier_delays =\n                    EXCLUDED.simulated_supplier_delays,\n                supplier_warnings =\n                    EXCLUDED.supplier_warnings,\n                supplier_critical =\n                    EXCLUDED.supplier_critical,\n                checked_at = NOW();\n        , parameters: None","try_number":1,"map_index":-1,"dag_id":"hourly_supply_chain_pipeline","run_id":"scheduled__2026-11-02T18:30:00+00:00","task_id":"monitor_anomalies","ti_id":"01a19d86-82a8-7c72-9cf1-4021cb5ce6d7","logger":"airflow.task.hooks.airflow.providers.postgres.hooks.postgres.PostgresHook","filename":"sql.py","lineno":896}
