{"timestamp":"2026-11-03T09:30:04.015189Z","level":"info","event":"Running statement: \n            INSERT INTO ops.hourly_operational_kpi_snapshots (\n                simulated_hour,\n                total_demand,\n                fulfilled_units,\n                unmet_units,\n                closing_stock,\n                stockout_rate_percent,\n                fulfillment_rate_percent,\n                projected_days_of_inventory,\n                captured_at\n            )\n\n            SELECT\n                snapshot_hour,\n                total_demand,\n                fulfilled_units,\n                unmet_units,\n                closing_stock,\n                stockout_rate_percent,\n                fulfillment_rate_percent,\n                projected_days_of_inventory,\n                NOW()\n\n            FROM ops.v_live_hourly_kpis\n\n            ORDER BY snapshot_hour DESC\n            LIMIT 1\n\n            ON CONFLICT (simulated_hour)\n            DO UPDATE SET\n                total_demand = EXCLUDED.total_demand,\n                fulfilled_units = EXCLUDED.fulfilled_units,\n                unmet_units = EXCLUDED.unmet_units,\n                closing_stock = EXCLUDED.closing_stock,\n                stockout_rate_percent =\n                    EXCLUDED.stockout_rate_percent,\n                fulfillment_rate_percent =\n                    EXCLUDED.fulfillment_rate_percent,\n                projected_days_of_inventory =\n                    EXCLUDED.projected_days_of_inventory,\n                captured_at = NOW();\n        , parameters: None","ti_id":"01a1a0be-7dc7-73b9-a564-fe11547b8e25","task_id":"save_operational_kpis","dag_id":"hourly_supply_chain_pipeline","run_id":"scheduled__2026-11-03T09:30:00+00:00","try_number":1,"map_index":-1,"logger":"airflow.task.hooks.airflow.providers.postgres.hooks.postgres.PostgresHook","filename":"sql.py","lineno":896}
