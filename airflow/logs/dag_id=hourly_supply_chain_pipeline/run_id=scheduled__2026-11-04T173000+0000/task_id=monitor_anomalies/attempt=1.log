{"timestamp":"2026-11-04T21:42:17.798986Z","level":"info","event":"Running statement: \n            INSERT INTO analytics.hourly_anomaly_snapshots (\n                snapshot_hour,\n                historical_demand_spikes,\n                simulated_supplier_delays,\n                supplier_warnings,\n                supplier_critical,\n                checked_at\n            )\n\n            SELECT\n                date_trunc('hour', NOW()),\n\n                COUNT(*) FILTER (\n                    WHERE anomaly_type = 'DEMAND_SPIKE'\n                ),\n\n                COUNT(*) FILTER (\n                    WHERE anomaly_type = 'SUPPLIER_DELAY'\n                ),\n\n                COUNT(*) FILTER (\n                    WHERE anomaly_type = 'SUPPLIER_DELAY'\n                      AND severity = 'WARNING'\n                ),\n\n                COUNT(*) FILTER (\n                    WHERE anomaly_type = 'SUPPLIER_DELAY'\n                      AND severity = 'CRITICAL'\n                ),\n\n                NOW()\n\n            FROM analytics.v_control_tower_anomalies\n\n            ON CONFLICT (snapshot_hour)\n            DO UPDATE SET\n                historical_demand_spikes =\n                    EXCLUDED.historical_demand_spikes,\n                simulated_supplier_delays =\n                    EXCLUDED.simulated_supplier_delays,\n                supplier_warnings =\n                    EXCLUDED.supplier_warnings,\n                supplier_critical =\n                    EXCLUDED.supplier_critical,\n                checked_at = NOW();\n        , parameters: None","map_index":-1,"dag_id":"hourly_supply_chain_pipeline","task_id":"monitor_anomalies","run_id":"scheduled__2026-11-04T17:30:00+00:00","try_number":1,"ti_id":"01a1a883-2682-7259-9a45-64e3a818dc46","logger":"airflow.task.hooks.airflow.providers.postgres.hooks.postgres.PostgresHook","filename":"sql.py","lineno":896}
